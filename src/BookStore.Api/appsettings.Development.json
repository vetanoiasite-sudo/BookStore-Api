{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Jwt": {
    "Secret": "development-only-signing-key-not-for-any-real-deployment",
    "AllowHttp": true
  },
  "Payment": {
    "SigningKey": "dev-only-fake-payment-signing-key"
  },
  "Wallet": {
    "SettlementDays": 0
  },
  "Auth": {
    "RequireVerifiedEmail": false
  },
  "RateLimiting": {
    "AuthPerMinute": 100
  }
}
