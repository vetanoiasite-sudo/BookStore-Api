# Copy to .env and fill in real values. Never commit a filled-in .env.
# In Development the API also reads appsettings.Development.json; environment
# variables always win. Double underscore maps to a configuration section.

# --- Database -------------------------------------------------------------
ConnectionStrings__Default=Server=.;Database=BookStore;Trusted_Connection=True;TrustServerCertificate=True

# --- Authentication -------------------------------------------------------
# Must be at least 32 characters. Generate a fresh value per environment.
Jwt__Secret=
Jwt__Issuer=bookstore-api
Jwt__Audience=bookstore-frontend
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# --- Platform economics ---------------------------------------------------
Platform__Currency=EGP
Platform__FeePercent=10
Shipping__FlatCost=30
Checkout__ReservationMinutes=30
# The sweep that puts unpaid reserved copies back on sale.
Checkout__ExpirySweepEnabled=true
Checkout__ExpirySweepSeconds=60
Wallet__SettlementDays=7
Orders__AutoCompleteDays=14

# --- File storage ---------------------------------------------------------
# Provider: Local (development) or a cloud provider added later.
Storage__Provider=Local
Storage__Root=wwwroot/uploads
Storage__PublicBaseUrl=/uploads
Storage__MaxImageBytes=5242880

# --- Payment provider -----------------------------------------------------
# Provider: Fake (development) or a real gateway in production.
Payment__Provider=Fake
Payment__SigningKey=

# --- Hosting --------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
Cors__AllowedOrigins__0=http://localhost:4200
